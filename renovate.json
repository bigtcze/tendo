{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "gomod", "dockerfile", "docker-compose", "github-actions", "mise", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"],
  "ignoreDeps": ["ghcr.io/bigtcze/tendo"],
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "dependencyDashboard": true,
  "labels": ["dependencies", "renovate"],
  "ignoreUnstable": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "separateMajorMinor": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "automerge": false,
    "labels": ["dependencies", "renovate", "security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "oapi-codegen invocation pin; generated output is completed by the developer",
      "managerFilePatterns": ["/^api/Makefile$/"],
      "matchStrings": ["OAPI_CODEGEN_VERSION := (?<currentValue>v[^\\s]+)"],
      "depNameTemplate": "oapi-codegen/oapi-codegen",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker image tags embedded in the proxy smoke shell script",
      "managerFilePatterns": ["/^scripts/proxy-smoke\\.sh$/"],
      "matchStrings": ["'(?<depName>caddy|nginx|traefik):(?<currentValue>[^']+)'", "(?<depName>curlimages/curl):(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep required indirect Go modules maintained as well as direct dependencies",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Only independent, stable, explicitly reviewed libraries may automerge patch/minor PRs",
      "matchManagers": ["npm", "gomod"],
      "matchPackageNames": ["clsx", "tailwind-merge", "ajv", "ajv-formats", "yaml", "@testing-library/jest-dom", "@testing-library/user-event", "github.com/go-chi/chi/v5"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": ">=1.0.0",
      "groupName": null,
      "automerge": true
    },
    {
      "description": "React runtime and matching type declarations migrate together",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React",
      "automerge": false
    },
    {
      "description": "Tailwind compiler and Vite integration migrate together",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "Tailwind CSS",
      "automerge": false
    },
    {
      "description": "ESLint core and its configuration package migrate together",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "groupName": "ESLint",
      "automerge": false
    },
    {
      "description": "Go runtime (mise.toml and mise.lock) and Go build images",
      "matchDepNames": ["go", "golang"],
      "groupName": "Go toolchain",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "The go directive is a deliberate language minimum, not the runtime pin",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    },
    {
      "description": "Node runtime (mise.toml and mise.lock) and build image; never Current",
      "matchDepNames": ["node"],
      "groupName": "Node.js LTS toolchain",
      "versioning": "node",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "PostgreSQL server and service images; all updates reviewed, majors need a data migration",
      "matchPackageNames": ["postgres"],
      "groupName": "PostgreSQL",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "sqlc generator (mise.toml and mise.lock): never complete without regenerated SQL code",
      "matchPackageNames": ["sqlc-dev/sqlc"],
      "groupName": "sqlc generator",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "mise binary version and SHA-256 in the CI toolchain action; mise.toml min_version is a compatibility floor",
      "matchPackageNames": ["jdx/mise"],
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "Go API generator: regenerate and migrate the contract in the same PR",
      "matchPackageNames": ["oapi-codegen/oapi-codegen"],
      "groupName": "oapi-codegen generator",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "TypeScript API generator: npm lockfile and generated artifacts must agree",
      "matchPackageNames": ["openapi-typescript"],
      "groupName": "openapi-typescript generator",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "Playwright: npm lockfile and browser revision require coordinated validation",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "groupName": "Playwright toolchain",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "Each action updates every workflow reference, without unrelated actions",
      "matchPackageNames": ["actions/checkout", "actions/cache", "actions/upload-artifact", "jdx/mise-action"],
      "groupName": "{{depName}} action",
      "groupSlug": "{{depName}}-action",
      "addLabels": ["toolchain", "migration-required"],
      "automerge": false
    },
    {
      "description": "Other images update one image family at a time; runtime changes never automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["caddy", "nginx", "traefik", "curlimages/curl", "gcr.io/distroless/base-debian13", "gcr.io/distroless/static-debian13"],
      "groupName": "{{depName}} image",
      "groupSlug": "{{depName}}-image",
      "automerge": false
    },
    {
      "description": "Track immutable digests for Distroless nonroot tags; Debian image-family migrations remain developer-owned",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/base-debian13", "gcr.io/distroless/static-debian13"],
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Nginx stable releases use even minor versions, not the odd-minor mainline",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "allowedVersions": "/^\\d+\\.(?:\\d*[02468])\\.\\d+(?:-.*)?$/"
    },
    {
      "description": "All majors require migration review, including allowlisted libraries",
      "matchUpdateTypes": ["major"],
      "addLabels": ["migration-required"],
      "automerge": false
    },
    {
      "description": "Runtime, generator, toolchain and workflow updates are proposals, never automatic merges",
      "matchManagers": ["custom.regex", "dockerfile", "docker-compose", "github-actions", "mise"],
      "automerge": false
    }
  ]
}
