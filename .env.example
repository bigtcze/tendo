POSTGRES_PASSWORD=
TENDO_DATABASE_PASSWORD=

TENDO_HOST_PORT=8080
TENDO_PUBLIC_URL=http://localhost:8080
TENDO_TRUSTED_PROXY_CIDRS=
# Automated-test clock only; TENDO_TEST_CLOCK_* must stay unset.
TENDO_DB_TIMEOUT=2
TENDO_SHUTDOWN_TIMEOUT=10
# Browser first-run setup code; empty disables creation. Clear after setup.
# Generate a 32-byte setup token: openssl rand -base64 32
TENDO_SETUP_TOKEN=
# Optional OIDC; see docs/admin/oidc.md. Leave issuer empty to disable.
# TENDO_OIDC_ISSUER=
# TENDO_OIDC_CLIENT_ID=
# TENDO_OIDC_CLIENT_SECRET=
# TENDO_OIDC_DISPLAY_NAME=OpenID Connect
TENDO_RESTART_POLICY=unless-stopped
