.env
.env.*
!.env.example
node_modules/

/dist/
/build/
/backend/bin/
*.test

# Frontend build output is embedded into the Go binary; only the placeholder is tracked.
backend/internal/platform/webui/dist/*
!backend/internal/platform/webui/dist/.gitkeep
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/

# Python bytecode from native harness tests.
__pycache__/
